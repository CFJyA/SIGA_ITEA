@section scripts {
    <script>
        function abrirExpediente(rowId, nombre, rfc, microregion, unidad, circulo) {
            // Quitar clase activa de todas las filas
            document.querySelectorAll('.alumnos-table tbody tr').forEach(r => r.classList.remove('active-row'));
            // Marcar la fila seleccionada
            document.getElementById(rowId).classList.add('active-row');
            
            // Llenar datos en el panel principal
            document.getElementById('lblNombreDetalle').innerText = nombre;
            document.getElementById('lblRfc').innerText = rfc;
            
            // Llenar datos en la tabla de Ubicación Operativa (Resumen)
            // Solo extraemos el número (ej. "385" de "385 ESC. SAN VALENTIN")
            document.getElementById('lblMicroregion').innerText = microregion;
            document.getElementById('lblUnidad').innerText = unidad.split(' ')[0];
            document.getElementById('lblCirculo').innerText = circulo;
            
            // Reemplazar todos los lugares donde dice el RFE mockeado por el real en las pestañas
            document.querySelectorAll('.dynamic-rfc').forEach(el => el.innerText = rfc);

            // Simular llenado de inputs separando el nombre
            let partes = nombre.split(' ');
            document.getElementById('txtAp1').value = partes[0] || '';
            document.getElementById('txtAp2').value = partes[1] || '';
            document.getElementById('txtNom').value = partes.slice(2).join(' ') || '';

            // Mostrar el panel con efecto
            let panel = document.getElementById('panelDetalle');
            panel.style.display = 'block';
            
            // Scroll suave hacia el panel
            panel.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }

        function cerrarExpediente() {
            document.getElementById('panelDetalle').style.display = 'none';
            document.querySelectorAll('.alumnos-table tbody tr').forEach(r => r.classList.remove('active-row'));
        }

        function cambiarSubTab(element, tabId) {
            // Quitar clase active de todos los tabs
            document.querySelectorAll('.sub-tab').forEach(t => t.classList.remove('active'));
            // Agregar active al clickeado
            element.classList.add('active');

            // Ocultar todos los contenedores
            document.querySelectorAll('.tab-content-container').forEach(c => c.classList.remove('active-content'));
            // Mostrar el seleccionado
            document.getElementById(tabId).classList.add('active-content');
        }
    </script>
}
